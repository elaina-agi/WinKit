<UserControl x:Class="WinKit.Desktop.Tools.NulCleanup.NulCleanupView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="28,24,28,22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20">
   <TextBlock Text="NUL 文件清理" Style="{StaticResource PageTitle}"/>
   <TextBlock Text="查找难以正常删除的 Windows 保留名称文件，由你确认后清理。" Style="{StaticResource MutedText}" Margin="0,7,0,0"/>
  </StackPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="扫描文件夹" FontWeight="SemiBold" Margin="0,0,0,9"/>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox AutomationProperties.AutomationId="FolderPath" AutomationProperties.Name="扫描文件夹路径" Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" ToolTip="{Binding RootPath}" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
     <Button Grid.Column="1" AutomationProperties.AutomationId="BrowseFolder" Content="浏览…" Command="{Binding BrowseCommand}" Margin="9,0,0,0"/>
     <Button Grid.Column="2" AutomationProperties.AutomationId="Scan" Content="开始扫描" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" Margin="9,0,0,0"/>
     <Button Grid.Column="3" AutomationProperties.AutomationId="Cancel" Content="取消" Command="{Binding CancelCommand}" Margin="9,0,0,0"/>
    </Grid>
    <TextBlock Grid.Row="2" Text="仅匹配 nul（不区分大小写）；不处理 null、nul.txt、文件夹或重解析点。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,11,0,0"/>
   </Grid>
  </Border>
  <StackPanel Grid.Row="2" Margin="0,0,0,15">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold" FontSize="15" AutomationProperties.AutomationId="StatusTitle"/><TextBlock Text="{Binding StatusDetail}" Style="{StaticResource MutedText}" Margin="0,5,0,0" AutomationProperties.AutomationId="StatusDetail"/></StackPanel>
    <Button Grid.Column="1" Content="查看扫描问题" Command="{Binding ShowIssuesCommand}" VerticalAlignment="Top" Margin="12,0,0,0" AutomationProperties.AutomationId="ScanIssues"/>
   </Grid>
   <ProgressBar IsIndeterminate="True" Height="3" Margin="0,11,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Foreground="{StaticResource PrimaryBrush}"/>
   <TextBlock Text="{Binding CurrentDirectory}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentDirectory}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
   <Border Background="#FFF4DE" BorderBrush="#E8D5AB" BorderThickness="1" CornerRadius="7" Padding="12,10" Margin="0,11,0,0" Visibility="{Binding HasNotice, Converter={StaticResource BoolVisibility}}">
    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="#745419"/>
   </Border>
  </StackPanel>
  <Border Grid.Row="3" Style="{StaticResource Card}" ClipToBounds="True">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="扫描结果" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <Button Grid.Column="1" Content="复制当前行路径" Command="{Binding CopyPathCommand}" Padding="11,6" MinHeight="30" AutomationProperties.AutomationId="CopyPath"/>
    </Grid>
    <DataGrid Grid.Row="1" AutomationProperties.AutomationId="Results" ItemsSource="{Binding Files}" SelectedItem="{Binding ActiveRow}" IsReadOnly="True" Margin="1,0,1,1">
     <DataGrid.Columns>
      <DataGridTemplateColumn Header="选择" Width="62" CanUserSort="False">
       <DataGridTemplateColumn.CellTemplate><DataTemplate>
        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" AutomationProperties.Name="{Binding FullPath}">
         <CheckBox.Style><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding CanSelect}" Value="False"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></CheckBox.Style>
        </CheckBox>
       </DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn Header="完整文件路径" Width="*" MinWidth="240" SortMemberPath="FullPath">
       <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding FullPath}" ToolTip="{Binding FullPath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="10,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn Header="大小" Width="100" SortMemberPath="Candidate.Size"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SizeText}" Margin="10,0" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Header="处理状态" Width="116" SortMemberPath="Status">
       <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" ToolTip="{Binding Message}" VerticalAlignment="Center" Margin="10,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="已删除"><Setter Property="Foreground" Value="#26764A"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="失败"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="已拒绝"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" Margin="30">
     <TextBlock Text="暂无结果" FontWeight="SemiBold" FontSize="17" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
     <TextBlock Text="扫描结果会显示在这里，默认不会勾选任何文件。" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextAlignment="Center"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="4" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <StackPanel Orientation="Horizontal"><Button AutomationProperties.AutomationId="SelectAll" Content="全选" Command="{Binding SelectAllCommand}" Padding="13,7" MinHeight="34"/><Button AutomationProperties.AutomationId="DeselectAll" Content="取消全选" Command="{Binding ClearSelectionCommand}" Padding="13,7" MinHeight="34" Margin="8,0,0,0"/><TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource MutedBrush}" AutomationProperties.AutomationId="SelectionSummary"/></StackPanel>
    <TextBlock Text="{Binding ScannedScope}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ScannedScope}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,12,0"/>
   </StackPanel>
   <StackPanel Grid.Column="1"><Button AutomationProperties.AutomationId="DeleteSelected" Content="删除所选" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource DangerButton}" MinWidth="114"/><TextBlock Text="永久删除 · 不进回收站" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,0" HorizontalAlignment="Center"/></StackPanel>
  </Grid>
 </Grid>
</UserControl>
