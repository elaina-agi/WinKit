<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- All theme dictionaries intentionally expose the same semantic brush keys. -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#F5F4F0"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#ECEDE8"/>
    <SolidColorBrush x:Key="TextBrush" Color="#202A35"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#586371"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#DCE1E4"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#BC343B"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#A92E36"/>
    <SolidColorBrush x:Key="ActionTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#E0E5E9"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#DCE7FC"/>
    <SolidColorBrush x:Key="NavSelectedTextBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#EEF2F7"/>
