    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#BAC4CF"/>
    <SolidColorBrush x:Key="ToolTipTextBrush" Color="#202A35"/>
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#F1F3F5"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#AAB4C0"/>
