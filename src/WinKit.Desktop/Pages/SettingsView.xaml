<UserControl x:Class="WinKit.Desktop.Pages.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="28,24,28,22">
   <TextBlock Text="设置" Style="{StaticResource PageTitle}"/><TextBlock Text="保持简单：只提供当前工具真正用得上的选项。" Style="{StaticResource MutedText}" Margin="0,7,0,24"/>
   <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16"><StackPanel>
    <TextBlock Text="工作习惯" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,17"/>
    <CheckBox Content="记住上次扫描的文件夹" IsChecked="{Binding RememberLastFolder}" AutomationProperties.AutomationId="RememberLastFolder"/>
    <TextBlock Text="下次启动时填入上次路径，但不会自动扫描、勾选或删除。关闭此项会清除保存的路径。" Style="{StaticResource MutedText}" Margin="22,8,0,0"/>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16"><StackPanel>
    <TextBlock Text="本地操作记录" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
    <TextBlock Text="记录扫描范围、处理结果和失败原因；不会上传网络。日志可能包含完整文件路径，请按需管理。" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
    <TextBox Text="{Binding LogPath, Mode=OneWay}" IsReadOnly="True" ToolTip="{Binding LogPath}" HorizontalScrollBarVisibility="Auto"/>
    <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Content="打开日志文件夹" Command="{Binding OpenLogFolderCommand}"/><Button Content="复制路径" Command="{Binding CopyLogPathCommand}" Margin="9,0,0,0"/></StackPanel>
   </StackPanel></Border>
   <TextBlock Text="{Binding SaveStatus}" Style="{StaticResource MutedText}" Margin="0,0,0,22"/>
   <TextBlock Text="安全默认值" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,9"/>
   <TextBlock Text="扫描结果默认不勾选；不跟随链接或目录联接；不自动提权；每次删除都需要你明确确认，且不经过回收站。" Style="{StaticResource MutedText}"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
