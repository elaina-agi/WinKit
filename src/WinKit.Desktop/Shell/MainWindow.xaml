<Window x:Class="WinKit.Desktop.Shell.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="WinKit · Windows 工具箱" Width="1180" Height="800" MinWidth="960" MinHeight="680" WindowStartupLocation="CenterScreen"
 Icon="/WinKit;component/Assets/WinKit.ico">
 <Window.Resources>
  <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="13,12"/><Setter Property="Margin" Value="0,3"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Frame" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#E0E5E9"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#DCE7FC"/><Setter Property="Foreground" Value="#1D4ED8"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers>
  </Style>
  <DataTemplate x:Key="NavigationTemplate">
   <Button Command="{Binding NavigateCommand}" Style="{StaticResource NavigationButton}" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Title}">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{Binding IconGeometry}" Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeLineJoin="Round"/><TextBlock Grid.Column="1" Text="{Binding Title}" Margin="9,0,0,0" VerticalAlignment="Center"/></Grid>
   </Button>
  </DataTemplate>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="206"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
   <Grid Margin="17,25,17,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="10,0,0,32"><StackPanel Orientation="Horizontal"><Border Background="#2563EB" Width="31" Height="31" CornerRadius="8" Margin="0,0,10,0"><Path Data="M 4,9 L 20,9 L 20,21 L 4,21 Z M 9,9 L 9,5 L 15,5 L 15,9 M 4,14 L 20,14 M 10,13 L 14,13 L 14,16 L 10,16 Z" Stroke="White" StrokeThickness="1.5" Stretch="Uniform" Width="20" Height="20"/></Border><TextBlock Text="WinKit" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="你的 Windows 工具箱" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,11,0,0"/></StackPanel>
    <ItemsControl Grid.Row="1" ItemsSource="{Binding ToolGroups}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,16"><TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="12,0,0,8"/><ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource NavigationTemplate}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <StackPanel Grid.Row="3"><Border Height="1" Background="{StaticResource BorderBrush}" Margin="6,0,6,11"/><ItemsControl ItemsSource="{Binding UtilityNavigation}" ItemTemplate="{StaticResource NavigationTemplate}"/></StackPanel>
    <TextBlock Grid.Row="4" Text="本地运行 · 安全优先   v0.1" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="11,17,0,0"/>
   </Grid>
  </Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,0"><Grid><TextBlock Text="{Binding CurrentTitle}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><TextBlock Text="离线工具 · 无需账号" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
   <ContentControl Grid.Row="1" Content="{Binding CurrentView}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  </Grid>
 </Grid>
</Window>
